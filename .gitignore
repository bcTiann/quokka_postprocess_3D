# Generated Python files and local editor settings.
**/__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
# Local Cython build products; the readable .pyx source is tracked.
/src/quokka2s/products/_gaussian_fractions.c
/src/quokka2s/products/_gaussian_fractions*.so
/src/quokka2s/products/_gaussian_fractions*.pyd
.ipynb_checkpoints/
.DS_Store
.vscode/
.claude/

# Snapshots and build intermediates stay local. Track the fixed process tables
# and their previous versions; exact exceptions follow the *.npz rule.
/inputs/*
!/inputs/tables/
/inputs/tables/*
!/inputs/tables/cloudy/
!/inputs/tables/despotic/
/inputs/tables/cloudy/*
/inputs/tables/despotic/*

# Table-building workspaces.
/runtime/
/archive/
/yt-env/

# Personal audit and experiment records are not public documentation.
/AGENTS.md
/tests/
/docs/validation/
/.venv/

# Numerical/figure files generated outside the standard output directories.
*.npy
*.npz
*.png
*.pdf
*.svg
*.csv
*.dat
*.ipynb

# Pinned molecular data used by the calculations belong with the code.
!vendor/molecular_data/LAMDA/*.dat

# Fixed prebuilt emission tables are supplied with a normal Git clone.
!/inputs/tables/cloudy/emission.npz
!/inputs/tables/cloudy/emission_old.npz
!/inputs/tables/despotic/interpolated.npz
!/inputs/tables/despotic/interpolated_old.npz

# Selected README examples; other generated figures remain local.
!/docs/examples/line_luminosity_halpha_intrinsic.png
!/docs/examples/line_luminosity_halpha_attenuated.png
!/docs/examples/spectrum_halpha.png

# Track generated Setonix results, including numerical and figure files.
!/output/**

# Local Julia runtime, package cache, and migration verification artifacts.
/output/diagnostics/julia_process_20261022/
