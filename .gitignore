# Generated Python files and local editor settings.
**/__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.ipynb_checkpoints/
.DS_Store
.vscode/
.claude/

# Large local inputs, generated products, and table-building workspaces.
# Transfer these separately from the source repository.
/inputs/
/output/
/runtime/
/archive/
/yt-env/

# Personal audit and experiment records are not public documentation.
/docs/validation/
/.venv/

# Numerical/figure files generated outside the standard output directories.
*.npy
*.npz
*.png
*.pdf
*.svg
*.csv
*.dat
*.ipynb

# Small scientific fixtures and pinned molecular data belong with the code.
!tests/data/velocity_kernel_reference.npz
!vendor/molecular_data/LAMDA/*.dat
