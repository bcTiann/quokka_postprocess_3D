#########################################################################
## Smoke: native HM2012 + filtered Black/ISM + CMB + CR + CT ###########
#########################################################################
cloudyExe = /Users/tianbaochen/cloudy/c17.02/source/cloudy.exe
saveCloudyOutputFiles = 1
exitOnCrash = 1
outputFilePrefix = hm2012_native_plus_filtered_ism_cmb_cr_ct_defaultabund_sixline_smoke
outputDir = /Users/tianbaochen/quokka_postprocess_3D/work/cloudy_cooling_tools_history/examples/grackle/hm2012_native_plus_filtered_ism_cmb_cr_ct_defaultabund_sixline_smoke_output
runStartIndex = 1
test = 0
cloudyRunMode = 4
lineMapLine = C  2 157.636m
lineMapLine = H  1 6562.81A
lineMapLine = H  1 21.1207c
lineMapLine = C  3 977.020A
lineMapLine = C  3 1906.68A
lineMapLine = C  3 1908.73A
coolingMapTmin = 1e4
coolingMapTmax = 1e4
coolingMapTpoints = 1
coolingScaleFactor = 1
coolingMapUseJeansLength = 0
command iterate to convergence
command stop temperature off
command set WeakHeatCool -20
command cosmic rays rate -16.698970
# Keep molecular chemistry disabled. Charge transfer remains enabled.
command no H2 molecule
command table SED "HM12_NATIVE_ISM_NH21_CMB/z_0.0000e+00.sed"
command f(nu) = -22.0006176315 at 1 Ryd
loop [hden] 0
loop [stop column density] 20
