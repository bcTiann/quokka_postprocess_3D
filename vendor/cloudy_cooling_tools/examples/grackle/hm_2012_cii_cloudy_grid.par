###########################################################
################ HM2012 [C II] Cloudy grid ################
###########################################################

##################### Run parameters ######################

cloudyExe               = /Users/tianbaochen/cloudy/c17.02/source/cloudy.exe
saveCloudyOutputFiles   = 1
exitOnCrash             = 0
outputFilePrefix        = hm_2012_cii_cloudy_grid
outputDir               = /Users/tianbaochen/quokka_postprocess_3D/work/cloudy_cooling_tools_history/examples/grackle/hm_2012_cii_cloudy_grid_output
runStartIndex           = 1

# Dry-run safety after interrupting the expensive 35 x 35 production run.
test                    = 1

# Local [C II] 157.636 micron emissivity mode.
cloudyRunMode           = 4
lineMapLine             = C  2 157.636m

################ Line-map temperature grid ################

# The high-temperature Cloudy branch begins at 3000 K.  The upper limit is
# the actual maximum temperature in the local DESPOTIC production table.
# Thirty-five logarithmic points match the number of points on each DESPOTIC
# input axis.
coolingMapTmin          = 3e3
coolingMapTmax          = 4.349742488077094e4
coolingMapTpoints       = 35
coolingScaleFactor      = 1

# N_H is an explicit lookup-table axis, not a Jeans-length estimate.
coolingMapUseJeansLength = 0

############ Commands to be executed every time ###########

command iterate to convergence
command stop temperature off
command set WeakHeatCool -20
command no H2 molecule
command no charge transfer

# Match the DESPOTIC/GOW gas-phase carbon abundance C/H = 1.6e-4.
command metals 0 log
command element carbon abundance -3.795880

################### Lookup-table axes ######################

# DESPOTIC density axis: log10(n_H/cm^-3) = -4 ... 6, 35 points.
loop [hden] (-4;6;0.2941176470588235)

# DESPOTIC column axis: log10(N_H/cm^-2) = 15 ... 24, 35 points.
# Values are explicit because CIAOLoop's incremental-loop parser can lose the
# upper endpoint through floating-point accumulation.
loop [stop column density] 15 15.2647058823529 15.5294117647059 15.7941176470588 16.0588235294118 16.3235294117647 16.5882352941176 16.8529411764706 17.1176470588235 17.3823529411765 17.6470588235294 17.9117647058824 18.1764705882353 18.4411764705882 18.7058823529412 18.9705882352941 19.2352941176471 19.5 19.7647058823529 20.0294117647059 20.2941176470588 20.5588235294118 20.8235294117647 21.0882352941176 21.3529411764706 21.6176470588235 21.8823529411765 22.1470588235294 22.4117647058824 22.6764705882353 22.9411764705882 23.2058823529412 23.4705882352941 23.7352941176471 24

# QUOKKA used the z=0 HM2012 UV background.
loop [init "HM12_UVB/z_*.out"] 0.0000e+00
