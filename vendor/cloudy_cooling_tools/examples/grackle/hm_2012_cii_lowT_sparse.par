############################################################
#### Sparse low-temperature HM2012 [C II] diagnostic ########
############################################################

cloudyExe               = /Users/tianbaochen/cloudy/c17.02/source/cloudy.exe

# Diagnostic comparison table only; production T<3000 K remains DESPOTIC.
saveCloudyOutputFiles   = 0
exitOnCrash             = 0
outputFilePrefix        = hm_2012_cii_lowT_sparse
outputDir               = /Users/tianbaochen/quokka_postprocess_3D/work/cloudy_cooling_tools_history/examples/grackle/hm_2012_cii_lowT_sparse_output
runStartIndex           = 1
test                    = 0

cloudyRunMode           = 4
lineMapLine             = C  2 157.636m

# Cloudy/logarithmic grids cannot include T=0.  Ten kelvin is the lowest
# previously validated temperature and 21 points give Delta log10(T)=0.124 dex.
coolingMapTmin          = 10
coolingMapTmax          = 3000
coolingMapTpoints       = 21
coolingScaleFactor      = 1
coolingMapUseJeansLength = 0

# Match the confirmed production physics exactly, so differences relative to
# DESPOTIC reflect the model rather than a changed abundance or radiation field.
command iterate to convergence
command stop temperature off
command set WeakHeatCool -20
command no H2 molecule
command no charge transfer
command metals 0 log
command element carbon abundance -3.795880

# Five existing production nodes spanning the full density range.
loop [hden] -4.71428571428571 -1.85714285714286 1 3.85714285714286 6

# Five existing production nodes spanning the full column-density range.
loop [stop column density] 15 17.5714285714286 19.5 22.0714285714286 24

loop [init "HM12_UVB/z_*.out"] 0.0000e+00
