###########################################################
######## Full-temperature HM2012 [C II] Cloudy grid #######
###########################################################

cloudyExe               = /Users/tianbaochen/cloudy/c17.02/source/cloudy.exe

# Keep only compact .dat output plus warnings.  This is a production grid,
# not a diagnostic run requiring every per-zone Cloudy output file.
saveCloudyOutputFiles   = 0
exitOnCrash             = 0
outputFilePrefix        = hm_2012_cii_cloudy_full
outputDir               = /Users/tianbaochen/quokka_postprocess_3D/work/cloudy_cooling_tools_history/examples/grackle/hm_2012_cii_cloudy_full_output
runStartIndex           = 1
test                    = 0

cloudyRunMode           = 4
lineMapLine             = C  2 157.636m

# Confirmed production temperature axis.  The sparse 5x5 scan found that the
# latest first exact Cloudy zero is log10(T)=6.436, and no C+ reappears through
# 1e9 K.  Keep that zero boundary as the final table node.
coolingMapTmin          = 3e3
coolingMapTmax          = 2.7289777828080403e6
# A 31-point logarithmic axis gives Delta log10(T) = 0.0986 dex.  Keep the
# full n_H and N_H axes; only temperature is coarsened to reduce runtime.
coolingMapTpoints       = 31
coolingScaleFactor      = 1

# Every run receives an explicit stop column density from the loop below.
# No Jeans-length column approximation is used.
coolingMapUseJeansLength = 0

# Retain the Grackle HM2012 Cloudy assumptions confirmed for this rebuild.
command iterate to convergence
command stop temperature off
command set WeakHeatCool -20
command no H2 molecule
command no charge transfer

# Match the DESPOTIC/GOW gas-phase carbon abundance C/H = 1.6e-4.
command metals 0 log
command element carbon abundance -3.795880

# Primary production run uses Cloudy's default electron-density solver.
# Any genuinely missing temperatures will be rerun separately with the
# previously validated secant solver; they are never filled numerically.

# log10(n_H/cm^-3), the original 15 points from -4 to 6 plus one new
# low-density point at -4.71428571428571.  This preserves every original node
# while covering the snapshot minimum n_H=7.14e-5 cm^-3 without clamping.
loop [hden] -4.71428571428571 -4 -3.28571428571429 -2.57142857142857 -1.85714285714286 -1.14285714285714 -0.428571428571428 0.285714285714286 1 1.71428571428571 2.42857142857143 3.14285714285714 3.85714285714286 4.57142857142857 5.28571428571429 6

# log10(N_H/cm^-2), 15 points from 15 to 24.
loop [stop column density] 15 15.6428571428571 16.2857142857143 16.9285714285714 17.5714285714286 18.2142857142857 18.8571428571429 19.5 20.1428571428571 20.7857142857143 21.4285714285714 22.0714285714286 22.7142857142857 23.3571428571429 24

loop [init "HM12_UVB/z_*.out"] 0.0000e+00
