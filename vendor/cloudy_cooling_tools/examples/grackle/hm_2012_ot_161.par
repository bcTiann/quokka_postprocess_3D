###########################################################
################ Santa Cruz Galaxy Project ################
################ Haardt & Madau (2012) UV background ######
###########################################################

###########################################################
##################### Run parameters ######################

# This is the official optically-thin hm_2012.par reduced to
# one comparison slice: hden = 0, redshift = 0.

# path to Cloudy executable
cloudyExe               = /Users/tianbaochen/cloudy/c17.02/source/cloudy.exe

# save component output required by subtract_cooling_lite.pl
saveCloudyOutputFiles   = 1

# exit if Cloudy crashes
exitOnCrash             = 1

# give this run a name
outputFilePrefix        = hm_2012_ot_161

# output directory
outputDir               = /Users/tianbaochen/quokka_postprocess_3D/work/cloudy_cooling_tools_history/examples/grackle/hm_2012_ot_161_output

# index of first run
runStartIndex           = 1

# this is not a test
test                    = 0

# select a run mode
cloudyRunMode           = 1 # cooling map mode

############################################################
################# Cooling Map Parameters ###################

coolingMapTmin = 1e1
coolingMapTmax = 1e9
coolingMapTpoints = 161

# 1: normalize heating/cooling by n_H^2
coolingScaleFactor = 1

############################################################
############ Commands to be executed every time ############

# Keep the official optically-thin illuminated-face behavior.
command stop zone 1

command iterate to convergence
command set WeakHeatCool -20
command no H2 molecule
command no charge transfer

command metals -3 log
#file metal_free.dat

#######################################################
############# Commands to be looped over ##############

loop [hden] 0
loop [init "HM12_UVB/z_*.out"] 0.0000e+00
