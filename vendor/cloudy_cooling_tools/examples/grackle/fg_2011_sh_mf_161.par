cloudyExe = /Users/tianbaochen/cloudy/c17.02/source/cloudy.exe
outputFilePrefix = fg_2011_sh_mf_161
outputDir = /Users/tianbaochen/quokka_postprocess_3D/work/cloudy_cooling_tools_history/examples/grackle/fg_2011_sh_mf_161_output
saveCloudyOutputFiles = 1
exitOnCrash = 1
runStartIndex = 1
test = 0
cloudyRunMode = 1

coolingMapTmin = 1e1
coolingMapTmax = 1e9
coolingMapTpoints = 161
coolingScaleFactor = 1
coolingMapUseJeansLength = 1

command failures 200 times map
command iterate to convergence max=2 error=0.20
#command stop zone 1
#command iterate to convergence
command set WeakHeatCool -20
command no H2 molecule
command no charge transfer
command metals 0
file metal_free.dat

loop [hden] 0
loop [init "FG11_UVB/z_*.out"] 0.0000e+00
