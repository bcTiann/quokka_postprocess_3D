###########################################################
################ Santa Cruz Galaxy Project ################
################ Haardt & Madau (2012) UV background ######
###########################################################

###########################################################
##################### Run parameters ######################

# path to Cloudy executable
cloudyExe               = /Users/tianbaochen/cloudy/c17.02/source/cloudy.exe

# don't save raw output from Cloudy
saveCloudyOutputFiles   = 1

# exit if Cloudy crashes
exitOnCrash             = 0

# give this run a name
outputFilePrefix        = hm_2012_sh_cii_5T

# output directory
outputDir               = /Users/tianbaochen/quokka_postprocess_3D/work/cloudy_cooling_tools_history/examples/grackle/hm_2012_sh_cii_5T_output

# index of first run
runStartIndex           = 1

# this is not a test
test                    = 0

# select a run mode
cloudyRunMode           = 4 # line emissivity mode


lineMapLine = C  2 157.636m

# Current Run Mode Options
# 0: Bare Mode - just run Cloudy with no data processing
# 1: Cooling Map Mode - create maps of heating and cooling vs. Te

############################################################
################# Cooling Map Parameters ###################

# minimum temperature
coolingMapTmin = 1e1

# maximum temperature
coolingMapTmax = 1e9

# number of steps (log space)
coolingMapTpoints = 5

# linear temperature step size
#coolingMapdT (currently redundant)

# log temperature step size
#coolingMapdLogT (currently redundant)

# scale factor for cooling/heating
# 1: n_H^2
# 2: n_H * n_e
coolingScaleFactor = 1

coolingMapUseJeansLength = 1

############################################################
############ Commands to be executed every time ############

# command stop zone 1

command iterate to convergence
command stop temperature off

# this command requires a temperature argument in Cloudy
# here no, because we will run it in a loop
# cLoop will take care of that
# command coronal equilibrium

command set WeakHeatCool -20

# turn off H2 molecule
command no H2 molecule

command no charge transfer

# Match the DESPOTIC/GOW gas-phase carbon abundance, C/H = 1.6e-4.
# Set the base metal mixture first because Cloudy's "metals" command also
# rescales an explicitly supplied carbon abundance.
command metals 0 log
command element carbon abundance -3.795880

#file metal_free.dat

#######################################################
############# Commands to be looped over ##############

loop [hden] 0

loop [init "HM12_UVB/z_*.out"] 0.0000e+00


